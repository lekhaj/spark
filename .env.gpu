# GPU Instances — g7e.2xlarge in us-east-1d (2026-06-13), RTX PRO 6000 Blackwell
#   spark_gpu_high      (on-demand · i-05e8570023728c112)
#   spark_gpu_spot_high (spot      · i-083d0209a8615302e)
# One EIP 52.91.128.47 rides whichever box is active.
# This file is BAKED INTO THE AMI and shared by both boxes; per-instance identity
# (spot vs on-demand) is resolved at runtime via IMDS, never hardcoded here.
# Source with: set -a && source .env.gpu && source .env.secrets && set +a

WORKER_TYPE=gpu
USE_CELERY=True
GPU_SPOT_INSTANCE_IP=127.0.0.1

# ── Redis — GPU connects back to CPU (spark_cpu_1) via private IP ──────────────
REDIS_BROKER_URL=redis://172.31.26.6:6379/0
REDIS_RESULT_BACKEND=redis://172.31.26.6:6379/0
REDIS_WRITE_URL=redis://172.31.26.6:6379/0
REDIS_READ_URL=redis://172.31.26.6:6379/0
REDIS_HOST=172.31.26.6
REDIS_PORT=6379
CELERY_BROKER_URL=redis://172.31.26.6:6379/0
CELERY_RESULT_BACKEND=redis://172.31.26.6:6379/0

# ── MongoDB — connects to CPU via private IP ──────────────────────────────────
# MONGO_URI / MONGODB_URL with credentials live in .env.secrets (gitignored)
MONGO_DB=World_builder
MONGODB_DB_NAME=World_builder

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=sparkassets-us
# Spot-interruption handling stays on; harmless on the on-demand box (it never
# receives a rebalance/termination notice). Lifecycle is resolved via IMDS.
AWS_GPU_IS_SPOT_INSTANCE=True
SPOT_INSTANCE_HANDLING_ENABLED=True

# ── Celery / manual-gen queue ─────────────────────────────────────────────────
# CPU enqueues to manual_gen_tasks_spot (see GPU_INSTANCE_MAP in .env.cpu); the
# manual-gen worker must consume the same queue.
GPU_WORKER_QUEUES=gpu_tasks
MANUAL_GEN_QUEUE=manual_gen_tasks_spot

# ── Attention backends (Blackwell sm_120 builds) ──────────────────────────────
# TRELLIS runs in-process and reads the global ATTN_BACKEND → xformers (built for
# sm_120). Pixal3D runs in a subprocess; PIXAL3D_ATTN overrides ATTN_BACKEND to
# sdpa for it (no flash_attn/natten built on Blackwell). 96 GB VRAM → low-VRAM
# splitting is unnecessary.
ATTN_BACKEND=xformers
# TRELLIS.2 sparse modules read SPARSE_ATTN_BACKEND (then fall back to
# ATTN_BACKEND). Pin xformers — flash_attn is not built for Blackwell sm_120.
# Sparse conv stays on the default flex_gemm extension (built for sm_120).
SPARSE_ATTN_BACKEND=xformers
PIXAL3D_ATTN=sdpa
PIXAL3D_LOW_VRAM=0
TRELLIS_REPO_PATH=/home/ec2-user/trellis
# TRELLIS.2 (package trellis2, class Trellis2ImageTo3DPipeline). The worker's
# trellis_model.py targets this API — not the original JeffreyXiang/TRELLIS.
TRELLIS_MODEL_ID=microsoft/TRELLIS.2-4B

# FLUX residency — 96 GB VRAM fits both FLUX pipelines fully on-GPU. Pin them
# (no CPU offload) for ~5-10x faster inference vs the small-GPU "sequential"
# default. FLUX.1-schnell ~24 GB, FLUX.1-dev+ControlNet ~30 GB.
FLUX_OFFLOAD=none
FLUX_CN_OFFLOAD=none

# ── HunyuanShapeGen ──────────────────────────────────────────────────────────
HUNYUAN3D_DEVICE=cuda
HUNYUAN3D_LOW_VRAM_MODE=False
HUNYUAN3D_COMPILE=False
HUNYUAN3D_STEPS=30
HUNYUAN3D_GUIDANCE_SCALE=7.5
HUNYUAN3D_OCTREE_RESOLUTION=256
HUNYUAN3D_NUM_CHUNKS=200000
HUNYUAN3D_REMOVE_BACKGROUND=True
HUNYUAN3D_ENABLE_FLASHVDM=True

# ── Output dirs ───────────────────────────────────────────────────────────────
OUTPUT_DIR=../outputs/generated_assets
OUTPUT_IMAGES_DIR=../outputs/generated_assets/images
OUTPUT_3D_ASSETS_DIR=../outputs/generated_assets/3d_assets

# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY come from .env.secrets (gitignored)
