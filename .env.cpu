# CPU Instance — spark_cpu_1 (t3.large · i-0f5a6edd3ce343281 · 18.207.13.85)
# Source with: set -a && source .env.cpu && source .env.secrets && set +a

WORKER_TYPE=cpu
USE_CELERY=True

# ── Redis (runs locally on this instance) ────────────────────────────────────
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/0
REDIS_WRITE_URL=redis://localhost:6379/0
REDIS_READ_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── MongoDB (runs locally on this instance) ───────────────────────────────────
# MONGODB_URL with credentials lives in .env.secrets (gitignored)
MONGODB_DB_NAME=World_builder

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=sparkassets-us

# GPU instances
# Active GPU = on-demand g6e.2xlarge in us-east-1b (relocated 2026-06-11).
# EIP 52.91.128.47 rides with whichever GPU instance is active.
AWS_GPU_INSTANCE_ID=i-089872baa8e109ca3
GPU_SPOT_INSTANCE_IP=52.91.128.47
AWS_GPU_IS_SPOT_INSTANCE=False
GPU_INSTANCE_MAP="manual_gen_tasks_spot=i-089872baa8e109ca3:L40S g6e.2xlarge"

# Enable the gpu_launcher.ensure_gpu_ready() auto-start path. Without this,
# the launcher returns (True, "disabled") instantly and the queue-time
# capacity-retry/warning logic never fires.
GPU_AUTO_LAUNCH=1

# ── Celery workers ────────────────────────────────────────────────────────────
CPU_WORKER_QUEUES=cpu_tasks,infrastructure

# ── Task defaults ─────────────────────────────────────────────────────────────
DEFAULT_TEXT_MODEL=flux
DEFAULT_GRID_MODEL=flux

# ── Output dirs ───────────────────────────────────────────────────────────────
OUTPUT_DIR=../outputs/generated_assets
OUTPUT_IMAGES_DIR=../outputs/generated_assets/images
OUTPUT_3D_ASSETS_DIR=../outputs/generated_assets/3d_assets

# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY come from .env.secrets (gitignored)
