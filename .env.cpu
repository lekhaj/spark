# CPU Instance — spark_cpu_1 (t3.large · i-0f5a6edd3ce343281 · 18.207.13.85)
# Source with: set -a && source .env.cpu && source .env.secrets && set +a

WORKER_TYPE=cpu
USE_CELERY=True

# ── Redis (runs locally on this instance) ────────────────────────────────────
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/0
REDIS_WRITE_URL=redis://localhost:6379/0
REDIS_READ_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── MongoDB (runs locally on this instance) ───────────────────────────────────
# MONGODB_URL with credentials lives in .env.secrets (gitignored)
MONGODB_DB_NAME=World_builder

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=sparkassets-us

# GPU fleet — g7e.2xlarge in us-east-1d (2026-06-13). The orchestrator brings ONE
# online at a time via gpu_launcher's spot-first / on-demand-fallback ladder.
# EIP 52.91.128.47 rides whichever box is active, so the CPU always reaches it.
AWS_GPU_SPOT_INSTANCE_ID=i-083d0209a8615302e   # spark_gpu_spot_high (preferred)
AWS_GPU_INSTANCE_ID=i-05e8570023728c112        # spark_gpu_high (on-demand fallback / default)
GPU_SPOT_INSTANCE_IP=52.91.128.47
AWS_GPU_IS_SPOT_INSTANCE=False
GPU_INSTANCE_MAP="manual_gen_tasks_spot=i-05e8570023728c112:g7e.2xlarge"

# Launcher relaunch params (used when AWS reclaims/deletes the spot → new spot
# from the baked g7e AMI, in parallel with the on-demand fallback).
# g7e golden AMI baked 2026-06-14 (spark-gpu-g7e-2026-06-14-v2): Blackwell sm_120,
# all 4 generators validated (FLUX, TRELLIS.2, Pixal3D+NAF/natten, Hunyuan3D),
# prewarmed, systemd auto-start (manual_gen_worker + spark-prewarm enabled).
# Used by gpu_launcher._launch_spot_from_ami to rebuild a reclaimed spot.
# (v1 ami-0936c09a4e949cabe = same but no systemd auto-start; can be deregistered.)
AWS_GPU_AMI_ID=ami-068f223026222d69c
AWS_GPU_INSTANCE_TYPE=g7e.2xlarge
AWS_GPU_SUBNET_ID=subnet-0c5b465f9ede9e6ce
AWS_GPU_SG_ID=sg-0d2c95823f90b5b25
AWS_GPU_KEY_NAME=us_cpu_key
AWS_GPU_INSTANCE_PROFILE=ec2_s3
AWS_GPU_EIP_ALLOC_ID=eipalloc-0db12aa4d8be94e92

# Enable the gpu_launcher.ensure_gpu_ready() auto-start path. Without this,
# the launcher returns (True, "disabled") instantly and the queue-time
# capacity-retry/warning logic never fires.
GPU_AUTO_LAUNCH=1

# ── Celery workers ────────────────────────────────────────────────────────────
CPU_WORKER_QUEUES=cpu_tasks,infrastructure

# ── Task defaults ─────────────────────────────────────────────────────────────
DEFAULT_TEXT_MODEL=flux
DEFAULT_GRID_MODEL=flux

# ── Output dirs ───────────────────────────────────────────────────────────────
OUTPUT_DIR=../outputs/generated_assets
OUTPUT_IMAGES_DIR=../outputs/generated_assets/images
OUTPUT_3D_ASSETS_DIR=../outputs/generated_assets/3d_assets

# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY come from .env.secrets (gitignored)
