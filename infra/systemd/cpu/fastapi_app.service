[Unit]
Description=FastAPI Application Service (spark - feature/claude-gen-code)
After=network.target mongod.service redis-server.service

[Service]
TimeoutStartSec=300
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/spark
EnvironmentFile=/home/ubuntu/spark/.env.cpu
EnvironmentFile=/home/ubuntu/spark/.env.secrets
Environment=PYTHONPATH=/home/ubuntu/spark:/home/ubuntu/spark/worker
ExecStart=/home/ubuntu/spark/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
