[Unit]
Description=Spark Mesh LOD Worker (CPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/spark/worker
EnvironmentFile=/home/ubuntu/spark/.env
ExecStart=/home/ubuntu/spark/venv/bin/python run_mesh_lod_worker.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
