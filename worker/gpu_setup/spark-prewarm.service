[Unit]
Description=Spark GPU pre-warm: read model weights into page cache to defeat EBS snapshot lazy-load
# Reads only LOCAL EBS files — no network needed. Gating on network-online.target
# could stall this (and the worker that orders After= it) on an AL2023 stop→start boot.
After=local-fs.target
Type=oneshot
User=ec2-user
Group=ec2-user
ExecStart=/usr/local/bin/spark-prewarm.sh
RemainAfterExit=true
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
